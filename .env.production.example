# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=db_auth

# JWT
JWT_SECRET=your_very_long_random_jwt_secret_here
JWT_EXP=1d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Yandex OAuth
YANDEX_APP_ID=your_yandex_app_id
YANDEX_APP_SECRET=your_yandex_app_secret

# Email (for verification emails)
EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Frontend URL (Vercel domain)
FRONTEND_URL=https://your-app.vercel.app

# Domain for SSL
DOMAIN=api.umyt.dev

# OAuth Callback URLs
GOOGLE_CALLBACK_URL=https://api.domain.dev/api/auth/google/callback
YANDEX_CALLBACK_URL=https://api.domain.dev/api/auth/yandex/callback
