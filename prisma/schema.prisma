generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  roles         Role[]
  provider      Provider?
  isBlocked     Boolean         @default(false) @map("is_blocked")
  isVerified    Boolean         @default(false) @map("is_verified")
  Token         Token[]
  PasswordReset PasswordReset[]
  EmailOtp      EmailOtp[]

  todos               Todo[]
  financeArticles     FinanceArticle[]
  financeAccounts     FinanceAccount[]
  financeValuations   FinanceAccountValuation[]
  financeRecords      FinanceRecord[]
  currencyConversions CurrencyConversion[]
  currencyRates       CurrencyRate[]
  financePlans        FinancePlan[]

  @@map("users")
}

model Token {
  token     String   @unique
  exp       DateTime
  createdAt DateTime @default(now()) @map("created_at")
  userId    String
  userAgent String   @map("user_agent")
  ip        String?
  deviceId  String?  @map("device_id")
  device    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  token     String    @unique
  exp       DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  userId    String
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model EmailOtp {
  id        String    @id @default(uuid())
  code      String
  exp       DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  userId    String
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, used, exp])
  @@map("email_otps")
}

enum Role {
  ADMIN
  USER
}

enum Provider {
  GOOGLE
  YANDEX
}

enum FinanceArticleKind {
  EXPENSE
  INCOME
}

enum FinanceRecordType {
  EXPENSE
  INCOME
}

enum FinanceAccountKind {
  CASH
  BANK
  CARD
  EWALLET
  CRYPTO
  SAVINGS
  INVESTMENT
  PROPERTY
  RECEIVABLE
  LOAN
  CREDIT_CARD
  OTHER
}

/// TRACKED  - balance is derived from opening balance + records + transfers.
/// VALUED   - balance is the latest manual valuation (property, market-priced assets).
enum FinanceAccountValuationMode {
  TRACKED
  VALUED
}

model Todo {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false) @map("is_completed")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("todos")
}

// Finance Models

model FinanceArticle {
  id         String             @id @default(uuid())
  userId     String             @map("user_id")
  kind       FinanceArticleKind
  name       String
  color      String?
  isArchived Boolean            @default(false) @map("is_archived")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  records FinanceRecord[]
  plans   FinancePlan[]

  @@unique([userId, kind, name], map: "finance_articles_user_kind_name_unique")
  @@index([userId, kind])
  @@map("finance_articles")
}

model FinanceRecord {
  id            String            @id @default(uuid())
  userId        String            @map("user_id")
  type          FinanceRecordType
  amount        Decimal           @db.Decimal(28, 8)
  currency      String            @db.VarChar(10)
  articleId     String?           @map("article_id")
  accountId     String?           @map("account_id")
  remark        String?
  operationDate DateTime          @map("operation_date")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  article FinanceArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  account FinanceAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, operationDate])
  @@index([userId, type])
  @@index([articleId])
  @@index([accountId, operationDate])
  @@map("finance_records")
}

model CurrencyRate {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  baseCurrency  String   @map("base_currency") @db.VarChar(10)
  quoteCurrency String   @map("quote_currency") @db.VarChar(10)
  rate          Decimal  @db.Decimal(38, 18)
  source        String?
  effectiveAt   DateTime @map("effective_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversions CurrencyConversion[]

  @@index([userId, baseCurrency, quoteCurrency, effectiveAt])
  @@map("currency_rates")
}

model CurrencyConversion {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  fromAmount    Decimal  @map("from_amount") @db.Decimal(28, 8)
  fromCurrency  String   @map("from_currency") @db.VarChar(10)
  toAmount      Decimal  @map("to_amount") @db.Decimal(28, 8)
  toCurrency    String   @map("to_currency") @db.VarChar(10)
  rateUsed      Decimal  @map("rate_used") @db.Decimal(38, 18)
  rateId        String?  @map("rate_id")
  fromAccountId String?  @map("from_account_id")
  toAccountId   String?  @map("to_account_id")
  feeAmount     Decimal? @map("fee_amount") @db.Decimal(28, 8)
  feeCurrency   String?  @map("fee_currency") @db.VarChar(10)
  remark        String?
  operationDate DateTime @map("operation_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rate        CurrencyRate?   @relation(fields: [rateId], references: [id], onDelete: SetNull)
  fromAccount FinanceAccount? @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccount   FinanceAccount? @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: SetNull)

  @@index([userId, operationDate])
  @@index([fromCurrency, toCurrency])
  @@index([fromAccountId, operationDate])
  @@index([toAccountId, operationDate])
  @@map("currency_conversions")
}

model FinanceAccount {
  id            String                      @id @default(uuid())
  userId        String                      @map("user_id")
  name          String
  kind          FinanceAccountKind
  valuationMode FinanceAccountValuationMode @default(TRACKED)
  currency      String                      @db.VarChar(10)

  /// Balance the account already held before any record in this app.
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(28, 8)
  openingDate    DateTime @map("opening_date")

  institution String?
  color       String?
  icon        String?

  /// Debt / loan bookkeeping. Only meaningful for LOAN, CREDIT_CARD, RECEIVABLE.
  counterparty String?   @map("counterparty")
  creditLimit  Decimal?  @map("credit_limit") @db.Decimal(28, 8)
  interestRate Decimal?  @map("interest_rate") @db.Decimal(9, 4)
  dueDate      DateTime? @map("due_date")

  isArchived          Boolean @default(false) @map("is_archived")
  excludeFromNetWorth Boolean @default(false) @map("exclude_from_net_worth")
  sortOrder           Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  records       FinanceRecord[]
  valuations    FinanceAccountValuation[]
  transfersFrom CurrencyConversion[]      @relation("TransferFrom")
  transfersTo   CurrencyConversion[]      @relation("TransferTo")
  plans         FinancePlan[]

  @@unique([userId, name], map: "finance_accounts_user_name_unique")
  @@index([userId, kind])
  @@index([userId, isArchived])
  @@map("finance_accounts")
}

model FinanceAccountValuation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  accountId String   @map("account_id")
  value     Decimal  @db.Decimal(28, 8)
  remark    String?
  valuedAt  DateTime @map("valued_at")
  createdAt DateTime @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, valuedAt])
  @@index([userId, valuedAt])
  @@map("finance_account_valuations")
}

/// What a plan promises: a ceiling on spending, a pot to fill, or an amount to
/// put aside each period.
enum FinancePlanKind {
  LIMIT
  GOAL
  SAVING
}

enum FinancePlanPeriod {
  MONTH
  QUARTER
  YEAR
  CUSTOM
}

/// A recurring rule, not a row per month: "500 on food, monthly, from
/// September" answers for every month that follows without being re-entered.
/// CUSTOM is the escape hatch for a one-off window bounded by startDate/endDate.
model FinancePlan {
  id       String            @id @default(uuid())
  userId   String            @map("user_id")
  kind     FinancePlanKind
  name     String
  amount   Decimal           @db.Decimal(28, 8)
  currency String            @db.VarChar(10)
  period   FinancePlanPeriod

  /// The rule applies from this date; endDate closes it (null = open-ended).
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  /// LIMIT caps one expense category; GOAL fills one account. SAVING needs
  /// neither — it measures income minus expense across everything.
  articleId String? @map("article_id")
  accountId String? @map("account_id")

  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  article FinanceArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  account FinanceAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, kind])
  @@index([userId, isArchived])
  @@map("finance_plans")
}
