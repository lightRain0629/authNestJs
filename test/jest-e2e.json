{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@prisma/client$": "<rootDir>/../node_modules/@prisma/client",
    "^@common/src/(.*)$": "<rootDir>/../libs/common/src/$1",
    "^@common$": "<rootDir>/../libs/common",
    "^@common/(.*)$": "<rootDir>/../libs/common/$1",
    "^@prisma$": "<rootDir>/../src/prisma",
    "^@prisma/(?!client)(.*)$": "<rootDir>/../src/prisma/$1",
    "^@user$": "<rootDir>/../src/user",
    "^@user/(.*)$": "<rootDir>/../src/user/$1",
    "^@auth$": "<rootDir>/../libs/auth",
    "^@auth/(.*)$": "<rootDir>/../libs/auth/$1",
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}